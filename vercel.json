{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m tools.publish",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/index" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/admin/", "destination": "/api/index" },
    { "source": "/admin_assets/:path*", "destination": "/api/index" }
  ]
}
